% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (prelim_design);
\chainin (aero) [join=by ProcessHVA];
\chainin (structures) [join=by ProcessHVA];
\chainin (propulsion) [join=by ProcessHVA];
\chainin (flight_perf) [join=by ProcessHVA];
\chainin (climate) [join=by ProcessHVA];
\chainin (cost) [join=by ProcessHVA];
\chainin (constraints) [join=by ProcessHVA];
\end{pgfonlayer}
}

