// Transonic Wing Design Algorithm Flowchart
digraph {
	fontsize=20 label="Transonic Wing Design Algorithm" labelloc=t rankdir=TD
	A [label="Start: Transonic Wing Design Algorithm" fillcolor="#cff" fontname=Helvetica shape=box style=filled]
	B [label="Define Inputs & Requirements" fillcolor="#cfc" fontname=Helvetica shape=parallelogram style=filled]
	C [label="Define Design Variables" fillcolor="#cfc" fontname=Helvetica shape=parallelogram style=filled]
	D [label="Initialize Optimization Loop / Select Design Point" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
	subgraph cluster_iteration {
		node [fontname=Helvetica style=filled]
		color=lightgrey fontname=Helvetica fontsize=16 label="Iteration / Design Point Evaluation" style=filled
		E [label="Calculate Wing Thickness Ratio (t/c)_w ?" fillcolor="#fcf" fontname=Helvetica shape=diamond style=filled]
		F [label="Is (t/c)_w Valid?" fillcolor="#fcf" fontname=Helvetica shape=diamond style=filled]
		G [label="Estimate/Iterate MTOW for current point" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		H [label="Calculate Wing Geometry: S_w, b_w" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		I [label="Calculate Aerodynamic Drag Components:
C_D_profile,wing, C_D_induced, C_D_compressibility, C_D_total" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		J [label="Calculate Propulsion Function: F_prop" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		K [label="Calculate Wing Structural Weight Parameters: Λ2, Λ3" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		L [label="Calculate Wing Penalty Function (WPF)" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		M [label="Calculate Figure of Merit (FOM)?" fillcolor="#fcf" fontname=Helvetica shape=diamond style=filled]
		N [label="Evaluate Constraints" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		O [label="Is Design Feasible?
(All Constraints Met)" fillcolor="#fcf" fontname=Helvetica shape=diamond style=filled]
		P [label="Is Current FOM better than Best FOM?" fillcolor="#fcf" fontname=Helvetica shape=diamond style=filled]
		Q [label="Update Best FOM & Store Optimal Design Parameters" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
		D -> E
		E -> F [label="Calculation Done"]
		F -> D [label="No, Invalid (t/c)_w
(Next Point/Stop)"]
		F -> G [label=Yes]
		G -> H
		H -> I
		I -> J
		J -> K
		K -> L
		L -> M
		M -> N [label="Calculation Done"]
		N -> O
		O -> D [label="No, Infeasible
(Next Point)"]
		O -> P [label=Yes]
		P -> D [label="No
(Next Point)"]
		P -> Q [label=Yes]
		Q -> D [label="Continue Loop
(Next Point)"]
	}
	R [label="Optimization Loop Ends / All Points Evaluated" fillcolor="#ccf" fontname=Helvetica shape=box style=filled]
	S [label="Output: Optimal Wing Design Parameters & FOM Value" fillcolor="#cfc" fontname=Helvetica shape=parallelogram style=filled]
	T [label=End fillcolor="#cff" fontname=Helvetica shape=box style=filled]
	A -> B
	B -> C
	C -> D
	D -> R [label="Loop Exit Condition Met
(e.g., Converged or All Points Done)"]
	R -> S
	S -> T
}
