# === 1. Buckling Calculation ===
def calculate_critical_buckling_stress(E, I, A, L, K_col=1.0):
    """
    Calculate the critical buckling stress for a column.
    Parameters:
        E (float): Young's modulus (Pa)
        I (float): Moment of inertia (m^4)
        A (float): Cross-sectional area (m^2)
        L (float): Length of the column (m)
        K_col (float): Column effective length factor (default is 1.0)
    Returns:
        float: Critical buckling stress (Pa)
    """
    if A == 0 or I == 0 or E == 0 or L == 0:
        return 0.0
    L_eff = K_col * L
    P_cr = (np.pi ** 2) * E * I / (L_eff ** 2)
    sigma_cr = P_cr / A
    return sigma_cr

# === 2. S-N Curve Function ===
def sn_curve(stress_ampl, A=1e10, m=3.0):
    """
    Calculate the number of cycles to failure based on the S-N curve.
    Parameters:
        stress_ampl (float): Stress amplitude (Pa)
        A (float): Material constant (default is 1e12)
        m (float): Slope of the S-N curve (default is 3.0)
    Returns:
        float: Number of cycles to failure
    """
    n_cycles = (A / stress_ampl) ** (1/m)
    return n_cycles

# === 3. Miner’s Rule Fatigue Damage Calculation ===
def miners_rule(stress_amplitudes, cycle_counts, A=1e12, m=3.0):
    """
    Calculate cumulative fatigue damage using Miner's Rule.
    Parameters:
        stress_amplitudes (list): List of stress amplitudes (Pa)
        cycle_counts (list): List of cycle counts for each stress amplitude
        A (float): Material constant for S-N curve (default is 1e12)
        m (float): Slope of the S-N curve (default is 3.0)
    Returns:
        float: Cumulative fatigue damage
    """
    damage = 0.0
    for sigma_a, n_i in zip(stress_amplitudes, cycle_counts):
        N_i = sn_curve(sigma_a, A, m)
        damage += n_i / N_i
    return damage

# === 4. S-N Curve Plot ===
def plot_sn_curve(A=1e12, m=3.0):
    stress_values = np.linspace(50e6, 300e6, 100)  # from 50 MPa to 300 MPa
    cycle_values = sn_curve(stress_values, A, m)

    plt.figure(figsize=(8, 6))
    plt.loglog(cycle_values, stress_values / 1e6, label=f"S-N Curve (A={A:.0e}, m={m})")
    plt.xlabel("Number of Cycles to Failure (N)", fontsize=12)
    plt.ylabel("Stress Amplitude (MPa)", fontsize=12)
    plt.title("S-N Curve (Log-Log Scale)", fontsize=14)
    plt.grid(True, which="both", linestyle="--", linewidth=0.5)
    plt.legend()
    plt.tight_layout()
    plt.show()

# === Example Fatigue Analysis for Given Buckling Parameters ===
if __name__ == "__main__":
    E = 70e9             # Pa (Aluminium)
    I = 8e-5            # m^4
    A = 0.004            # m^2
    L = 2.0              # m
    K_col = 1.0

    sigma_cr = calculate_critical_buckling_stress(E, I, A, L, K_col)

    # Define fatigue load spectrum as percentage of sigma_cr
    stress_percentages = np.array([0.4, 0.35, 0.30, 0.25])  # load levels
    stress_amplitudes = stress_percentages * sigma_cr   # actual amplitudes
    print(f"Critical Buckling Stress (σ_cr): {sigma_cr / 1e6:.2f} MPa")
    print(f"Stress Amplitudes (MPa): {stress_amplitudes / 1e6}")
    cycle_counts = [1e4, 1e5, 2e5, 5e5]                  # typical cycles

    # Calculate fatigue damage
    D_total = miners_rule(stress_amplitudes, cycle_counts)

    # Output tabulated result
    df = pd.DataFrame({
        "Stress % of σ_cr": stress_percentages,
        "Stress Amplitude (MPa)": np.round(stress_amplitudes / 1e6, 2),
        "Cycles Applied": cycle_counts,
        "Cycles to Failure (N_i)": [int(sn_curve(sigma)) for sigma in stress_amplitudes],
        "Damage Fraction (n_i/N_i)": [n / sn_curve(sigma) for sigma, n in zip(stress_amplitudes, cycle_counts)]
    })
    df["Cumulative Damage"] = df["Damage Fraction (n_i/N_i)"].cumsum()

    print("\nFatigue Damage Summary:\n")
    print(df.to_string(index=False))
    print(f"\nTotal Cumulative Damage (Miner's Rule): D = {D_total:.2f}")

    # Plot the S-N curve
    plot_sn_curve()
