\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
\node [DataIO] (output_sizing) {$Mission definition, fuel fractions, $L/D$, SFC, $OEW/MTOW$$};&
&
&
&
&
\\
%Row 1
\node [MDA] (sizing) {$Class I weight estimation$};&
\node [DataInter] (sizing-multidisciplinary) {$$L/D$, SFC$};&
\node [DataInter] (sizing-structures) {$OEW$};&
\node [DataInter] (sizing-aero) {$$L/D$$};&
&
\node [DataIO] (right_output_sizing) {$OEW, MTOW, Fuel weight$};\\
%Row 2
\node [DataInter] (multidisciplinary-sizing) {$OEW$};&
\node [MDA] (multidisciplinary) {$Engine selection, Fuselage sizing, Wing sizing \& preliminary positioning, Preliminary tail sizing \& positioning$};&
&
&
&
\node [DataIO] (right_output_multidisciplinary) {$3D views, $n_{ult}$$};\\
%Row 3
&
\node [DataInter] (structures-multidisciplinary) {$OEW$};&
\node [MDA] (structures) {$Class II weight estimation, c.g. determination$};&
&
&
\node [DataIO] (right_output_structures) {$OEW, c.g. range$};\\
%Row 4
&
&
\node [DataInter] (aero-structures) {$Tail size and position, Wing position, Landing gear position$};&
