% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sizing);
\chainin (multidisciplinary) [join=by ProcessHVA];
\chainin (structures) [join=by ProcessHVA];
\chainin (aero) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(sizing) edge [DataLine] (sizing-multidisciplinary)
(sizing) edge [DataLine] (sizing-structures)
(sizing) edge [DataLine] (sizing-aero)
(multidisciplinary) edge [DataLine] (multidisciplinary-sizing)
(structures) edge [DataLine] (structures-multidisciplinary)
(aero) edge [DataLine] (aero-structures)
(sizing) edge [DataLine] (right_output_sizing)
(multidisciplinary) edge [DataLine] (right_output_multidisciplinary)
(structures) edge [DataLine] (right_output_structures)
% Vertical edges
(sizing-multidisciplinary) edge [DataLine] (multidisciplinary)
(sizing-structures) edge [DataLine] (structures)
(sizing-aero) edge [DataLine] (aero)
(multidisciplinary-sizing) edge [DataLine] (sizing)
(structures-multidisciplinary) edge [DataLine] (multidisciplinary)
(aero-structures) edge [DataLine] (structures)
(sizing) edge [DataLine] (output_sizing);
\end{pgfonlayer}

\end{tikzpicture}
